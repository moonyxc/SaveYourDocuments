{
  "name": "saveyourdocuments",
  "version": "1.0.0",
  "description": "Desktop-App zum Scannen, Erkennen, Kategorisieren und Verwalten von Dokumenten mit OCR",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:vite": "vite",
    "build": "tsc -p tsconfig.main.json && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:all": "electron-builder --win --linux --mac",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron --ext ts,tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": true,
    "node-llama-cpp": true,
    "tesseract.js": true,
    "electron-winstaller": true,
    "sharp": true,
    "electron": true,
    "esbuild": true
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.0",
    "electron-log": "^5.4.4",
    "node-llama-cpp": "^3.0.0",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.0.0",
    "uuid": "^14.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "simple-update-notifier": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^7.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
