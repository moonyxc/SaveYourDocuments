# App Configuration
APP_NAME=SaveYourDocuments
APP_VERSION=1.0.0

# Database
DB_NAME=documents.db

# Storage
STORAGE_DIR=storage
THUMBNAILS_DIR=thumbnails
LOGS_DIR=logs
BACKUPS_DIR=backups
MODELS_DIR=models

# OCR
OCR_CONFIDENCE_THRESHOLD=70
TESSERACT_LANG=deu+eng

# Vision Model
VISION_MODEL_NAME=ocr-vision-8b.gguf
VISION_MODEL_URL=
VISION_MODEL_SHA256=

# Security
# MASTER_PASSWORD is set at runtime, never stored
